//prog of calculating percentage using rest and spread operator
//Spread unpacks elements (boxes them out).Rest packs elements (gathers them into a single array).
const marks = [85, 90, 78, 92, 88];

// 2. A simple function that uses REST (...) to pack inputs into an array
function getPercentage(...allMarks) {
  // Add the marks together
  let total = allMarks[0] + allMarks[1] + allMarks[2] + allMarks[3] + allMarks[4];
   // Calculate percentage (Total divided by 500, then multiplied by 100)
  return (total / 500) * 100;
}
// 3. Call the function using SPREAD (...) to unpack the array
const result = getPercentage(...marks);

console.log(`Percentage: ${result}%`); // Output: Percentage: 86.6%

